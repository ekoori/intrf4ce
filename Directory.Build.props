<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Deck titles and file names are not ASCII. Invariant globalization would break casing. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      IDE0005 (unused using) only runs on build when the documentation file is generated.
      We want the dead-code check, not the docs:
        CS1591 - member has no XML comment. Requiring one everywhere is noise.
        CS1573 - some parameters documented but not all. Documenting only the surprising
                 parameter is the house style.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>intrf4ce</Product>
    <Company>intrf4ce</Company>
    <Authors>ekoori</Authors>
    <Copyright>Copyright © ekoori</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
